---
import FriendGuide from "@components/organisms/FriendGuide.svelte";
import FriendSection from "@components/organisms/FriendSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	friendPageConfig,
	resolveFriendCheckOptions,
	resolveFriendNotes,
	resolveFriendSiteInfo,
	resolveFriendTemplate,
} from "@/config";
import { resolveAsset } from "@/utils/asset-utils";
import { isPageAvailable } from "@/utils/page-availability";
import { getFriendsList } from "../data/friends";

if (!isPageAvailable("friends")) {
	return Astro.redirect("/404/");
}

// 信息模块：site 缺省回退 profile/site 配置，头像的本地相对路径在 SSR 侧解析为产物 URL
const friendSite = resolveFriendSiteInfo();
const friendAvatarUrl = await resolveAsset(friendSite.avatar ?? "");
// 检测运行时契约：SSR 解析后经 props 下发，客户端组件不直接读 config
const friendCheck = resolveFriendCheckOptions();
---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friendsBanner)} page="friends">
    <FriendSection friends={getFriendsList()} check={friendCheck} client:visible></FriendSection>
    {
        friendPageConfig.enable && (
            <FriendGuide
                site={{ ...friendSite, avatar: friendAvatarUrl }}
                template={resolveFriendTemplate()}
                notes={resolveFriendNotes()}
                client:visible
            />
        )
    }
</MainGridLayout>
