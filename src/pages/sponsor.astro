---
import SponsorSection from "@components/organisms/SponsorSection.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { isPageAvailable } from "@/utils/page-availability";

if (!isPageAvailable("sponsor")) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout
	title={i18n(I18nKey.sponsor)}
	description={i18n(I18nKey.sponsorBanner)}
	page="sponsor"
>
	<SponsorSection class="onload-animation" />
</MainGridLayout>
