---
/** 技能页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import SkillSection from "@components/organisms/SkillSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { skillsConfig } from "@/config/skillsConfig";
import { resolveSkillsData } from "@/utils/feature-data";
import { isPageAvailable } from "@/utils/page-availability";

if (!isPageAvailable("skills")) {
	return Astro.redirect("/404/");
}

const items = resolveSkillsData(skillsConfig);
---

<MainGridLayout
	title={i18n(I18nKey.skills)}
	description={i18n(I18nKey.skillsBanner)}
	page="skills"
>
	<SkillSection
		categories={skillsConfig.categories}
		items={items}
		client:visible
	/>
</MainGridLayout>
