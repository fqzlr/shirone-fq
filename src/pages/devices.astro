---
/** 设备页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import DeviceSection from "@components/organisms/DeviceSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { devicesConfig } from "@/config/devicesConfig";
import { resolveDevicesData } from "@/utils/feature-data";
import { isPageAvailable } from "@/utils/page-availability";

if (!isPageAvailable("devices")) {
	return Astro.redirect("/404/");
}

const items = resolveDevicesData(devicesConfig);
---

<MainGridLayout
	title={i18n(I18nKey.devices)}
	description={i18n(I18nKey.devicesBanner)}
	page="devices"
>
	<DeviceSection
		categories={devicesConfig.categories}
		items={items}
		client:visible
	/>
</MainGridLayout>
