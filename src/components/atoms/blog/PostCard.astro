---
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * M3E 博客原子 — PostCard 文章卡片。
 * 数据驱动：标题 / 描述 / 封面 / 元信息（复用 blog/PostMeta）/ 阅读时长。
 * 视觉对齐 display/Card 令牌：surface-container-high 基、corner-large、
 * hover 抬升阴影 + 标题 primary + 箭头滑出；有封面时桌面端右侧 28% 图。
 */
import { Icon } from "astro-icon/components";
import type { BlogMetaLink } from "./PostMeta.astro";

interface Props {
	href: string;
	title: string;
	description?: string;
	/** 封面图地址（省略则无封面；开启随机封面回退时由 randomCover 兜底） */
	image?: string;
	/** 随机封面回退（仅无 image 时传入）：src 为图床随机图端点，fallback 为本地兜底图 */
	randomCover?: { src: string; fallback: string };
	imageSrcset?: string;
	imageAvifSrcset?: string;
	imageSizes?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageAlt?: string;
	published?: string;
	updated?: string;
	pinned?: boolean;
	encrypted?: boolean;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 字数展示文本（如 "1426 words"，渲染在分类右侧） */
	wordCount?: string;
	/** 阅读时长展示文本（如 "5 分钟"，grid 模式底部展示） */
	readingTime?: string;
	class?: string;
	style?: string;
}

const {
	href,
	title,
	description,
	image,
	randomCover,
	imageSrcset,
	imageAvifSrcset,
	imageSizes,
	imageWidth,
	imageHeight,
	imageAlt = "",
	published,
	updated,
	pinned = false,
	encrypted = false,
	category = null,
	tags = [],
	wordCount,
	readingTime,
	class: className,
	style,
} = Astro.props;

const hasCover = !!image || !!randomCover;
const pinnedLabel = i18n(I18nKey.pinned);
const encryptedLabel = i18n(I18nKey.postEncryptedBadge);
/* 置顶 + 加密并存时合入可访问名称，避免屏幕阅读器丢失任一状态 */
const stateLabels = [
	pinned ? pinnedLabel : "",
	encrypted ? encryptedLabel : "",
].filter(Boolean);
const titleLabel =
	stateLabels.length > 0 ? `${title}, ${stateLabels.join(", ")}` : title;
---

<article
	class:list={["m3-blog-postcard", { "m3-blog-postcard--cover": hasCover, "m3-blog-postcard--pinned": pinned }, className]}
	style={style}
>
	{hasCover ? (
		<a class="m3-blog-postcard__cover" href={href} aria-label={title}>
			<span class="m3-blog-postcard__cover-loading" aria-hidden="true"></span>
			<picture>
				{imageAvifSrcset && <source type="image/avif" srcset={imageAvifSrcset} sizes={imageSizes} />}
				<img
					src={image || randomCover?.src || ""}
					srcset={imageSrcset}
					sizes={imageSizes}
					width={imageWidth}
					height={imageHeight}
					alt={imageAlt}
					loading="lazy"
					decoding="async"
					data-fallback={randomCover?.fallback}
					onload="this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
					onerror={randomCover
						? "if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback='';}this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"
						: "this.parentElement?.previousElementSibling?.classList.add('m3-blog-postcard__cover-loading--done')"}
				/>
			</picture>
			{/* 封面已作为卡片背景层融合，hover 反馈交由卡片阴影、标题变色与图片轻放大，不再叠加深色遮罩与箭头 */}
			</a>
	) : (
		<a class="m3-blog-postcard__enter" href={href} aria-label={title}>
			<Icon name="material-symbols:chevron-right-rounded" />
		</a>
	)}
	<div class="m3-blog-postcard__body">
		<a
			class="m3-blog-postcard__title"
			href={href}
			aria-label={titleLabel}
		>
			<AccentBar size="medium" />
			{pinned && (
				<span
					class:list={[
						"m3-blog-postcard__pin",
						{ "m3-blog-postcard__pin--locked": encrypted },
					]}
					aria-hidden="true"
					title={encrypted ? `${pinnedLabel}, ${encryptedLabel}` : pinnedLabel}
				>
					<Icon name="material-symbols:keep-rounded" />
					{encrypted && (
						<span class="m3-blog-postcard__pin-lock">
							<Icon name="material-symbols:lock-rounded" />
						</span>
					)}
				</span>
			)}
			{encrypted && !pinned && (
				<span class="m3-blog-postcard__encrypted" aria-hidden="true" title={encryptedLabel}>
					<Icon name="material-symbols:lock-rounded" />
				</span>
			)}
			<span class="m3-blog-postcard__title-text">{title}</span>
			<Icon class="m3-blog-postcard__arrow" name="material-symbols:chevron-right-rounded" />
		</a>
		{/* 分类 + 标签行：置顶/加密徽章 + 分类（书本图标）+ 标签组（# 图标，/ 分隔） */}
		<div class="m3-blog-postcard__category-tags">
			{pinned && (
				<span class="m3-blog-postcard__state-badge m3-blog-postcard__state-badge--pinned">
					<Icon name="material-symbols:keep-rounded" />
					{pinnedLabel}
				</span>
			)}
			{encrypted && !pinned && (
				<span class="m3-blog-postcard__state-badge m3-blog-postcard__state-badge--encrypted">
					<Icon name="material-symbols:lock-rounded" />
					{encryptedLabel}
				</span>
			)}
			{category && (
				<span class="m3-blog-postcard__category">
					<MetaIcon icon="material-symbols:book-2-outline-rounded" />
					<a class="m3-blog-postcard__category-link" href={category.href}>{category.name}</a>
				</span>
			)}
			{tags.length > 0 && (
				<Fragment>
					<span class="m3-blog-postcard__tag-hash" aria-hidden="true">
						<MetaIcon icon="material-symbols:tag-rounded" />
					</span>
					{tags.map((t, i) => (
						<span class="m3-blog-postcard__tag-unit">
							{i > 0 && <span class="m3-blog-postcard__sep" aria-hidden="true">/</span>}
							<a class="m3-blog-postcard__tag-link" href={t.href}>{t.name}</a>
						</span>
					))}
				</Fragment>
			)}
		</div>
		{description && <p class="m3-blog-postcard__desc">{description}</p>}
		{/* 底部：日期 / 字数 / 阅读时间 */}
		<div class="m3-blog-postcard__footer">
			{published && (
				<span class="m3-blog-postcard__footer-item">
					<MetaIcon icon="material-symbols:calendar-today-outline-rounded" />
					<span>{published}</span>
				</span>
			)}
			{wordCount && (
				<span class="m3-blog-postcard__footer-item">
					<MetaIcon icon="material-symbols:article-outline-rounded" />
					<span>{wordCount}</span>
				</span>
			)}
			{readingTime && (
				<span class="m3-blog-postcard__footer-item">
					<MetaIcon icon="material-symbols:schedule-outline-rounded" />
					<span>{readingTime}</span>
				</span>
			)}
		</div>
	</div>
</article>

<style lang="stylus">
@import "../../../styles/breakpoints.styl"
.m3-blog-postcard
	position: relative
	display: flex
	/* 移动端/Grid 封面置顶（cover 已在 DOM 最前，故用 column） */
	flex-direction: column
	box-sizing: border-box
	width: 100%
	overflow: hidden
	border-radius: var(--shape-corner-l)
	/* 卡片边框：常态淡实线，hover（选中）变虚线加深（浅色近黑/暗色自动反转近白） */
	border: 1px solid var(--line-divider)
	/* 站点卡片色（浅色 = surface-container-lowest 近白），与侧栏等其它卡片一致 */
	background: var(--card-bg)
	color: var(--on-surface)
	transition:
		box-shadow var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate),
		background-color var(--m3e-duration-medium) var(--m3e-easing-standard),
		border-color 300ms ease
	&:hover
		box-shadow: var(--m3e-elevation-2)
		background: unquote("color-mix(in oklab, var(--on-surface) 3%, var(--card-bg))")
		border-color: var(--on-surface)
		border-style: dashed

	/* 置顶文章：常态红色实线边框（明暗一致），hover 变红色虚线 */
	&--pinned
		border-color: #e53e3e
	&--pinned:hover
		border-color: #e53e3e
		border-style: dashed

	&__body
		position: relative
		/* 文字层浮于封面渐变区之上：图片 absolute 且 DOM 靠后会覆盖同层文字，
		   抬高层级后渐变区只作为文字下方的背景，不影响可读性 */
		z-index: 2
		flex: 1
		min-width: 0
		padding: 1.25rem 1.5rem 1rem

	&__title
		display: flex
		align-items: center
		gap: 0.5rem
		margin: 0
		font: var(--m3e-type-title-medium)
		font-weight: 700
		line-height: 1.4
		color: var(--on-surface)
		text-decoration: none
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		.m3-blog-postcard:hover &
			color: var(--primary)

	&__arrow
		flex-shrink: 0
		width: 1.5rem
		height: 1.5rem
		color: var(--primary)
		transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)
		.m3-blog-postcard:hover &
			transform: translateX(0.25rem)

	&__pin
		position: relative
		display: inline-flex
		align-items: center
		justify-content: center
		flex: 0 0 1.75rem
		height: 1.75rem
		border-radius: var(--shape-corner-m)
		background: var(--primary-container)
		color: var(--on-primary-container)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem

	&__encrypted
		display: inline-flex
		align-items: center
		justify-content: center
		flex: 0 0 1.75rem
		height: 1.75rem
		border-radius: var(--shape-corner-m)
		background: var(--tertiary-container)
		color: var(--on-tertiary-container)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem

	/* 置顶 + 加密角标：tertiary 小锁圆点叠加在 pin 徽标右上角（BadgedBox 语言），
	   带卡片色描边与背景分离，整体宽度与单 pin 徽标一致 */
	&__pin-lock
		position: absolute
		top: -0.375rem
		right: -0.375rem
		display: inline-flex
		align-items: center
		justify-content: center
		width: 1rem
		height: 1rem
		border-radius: var(--shape-corner-full)
		background: var(--tertiary-container)
		color: var(--on-tertiary-container)
		box-shadow: 0 0 0 2px var(--card-bg)
		> :global(svg)
			width: 0.625rem
			height: 0.625rem

	&__desc
		margin: var(--m3e-space-2) 0 0
		font: var(--m3e-type-body-medium)
		/* 对应站点 .text-75 */
		color: unquote("color-mix(in oklab, var(--on-surface) 78%, transparent)")
		line-height: 1.6
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden

	/* 分类 + 标签行：单行排布，溢出时按「标签」粒度换行（分隔符跟随所属标签） */
	&__category-tags
		display: flex
		align-items: center
		flex-wrap: wrap
		gap: 0.375rem 0.25rem
		margin-top: var(--m3e-space-2)
		font: var(--m3e-type-body-small)
		color: var(--on-surface-variant)
		/* 卡片内的元信息图标：去 tonal 方块，透明小图标（参考站语言） */
		:global(.m3-meta-icon)
			width: 1.125rem
			height: 1.125rem
			border-radius: 0
			background: transparent
			color: inherit
			flex-shrink: 0
			> :global(svg)
				width: 1rem
				height: 1rem

	&__category,
	&__tag-unit
		display: inline-flex
		align-items: center
		gap: 0.375rem
		flex-shrink: 0

	/* 标签组 # 图标用主色点缀，与分类保持一档间距 */
	&__tag-hash
		display: inline-flex
		align-items: center
		margin-left: 0.5rem
		flex-shrink: 0
		:global(.m3-meta-icon)
			color: var(--primary)

	&__state-badge
		display: inline-flex
		align-items: center
		gap: 0.25rem
		margin-right: 0.5rem
		padding: 0.125rem 0.5rem
		border-radius: var(--shape-corner-s)
		background: var(--primary-container)
		color: var(--on-primary-container)
		font-weight: 500
		> :global(svg)
			width: 0.875rem
			height: 0.875rem

	&__state-badge--encrypted
		background: var(--tertiary-container)
		color: var(--on-tertiary-container)

	&__category-link
		color: var(--on-surface)
		text-decoration: none
		white-space: nowrap
		font-weight: 500
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			color: var(--primary)

	&__tag-link
		color: var(--on-surface-variant)
		text-decoration: none
		white-space: nowrap
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			color: var(--primary)

	&__sep
		margin: 0 0.25rem
		color: var(--outline-variant)

	/* 底部：日期 | 字数 | 阅读时间 —— 透明小图标 + 浅灰文字（参考站语言），竖线分隔 */
	&__footer
		display: flex
		align-items: center
		margin-top: var(--m3e-space-3)
		height: 1.5rem
		overflow: hidden
		white-space: nowrap
		font: var(--m3e-type-body-small)
		color: unquote("color-mix(in oklab, var(--on-surface) 55%, transparent)")
		:global(.m3-meta-icon)
			width: 1.125rem
			height: 1.125rem
			border-radius: 0
			background: transparent
			color: inherit
			flex-shrink: 0
			> :global(svg)
				width: 1rem
				height: 1rem

	&__footer-item
		display: inline-flex
		align-items: center
		gap: 0.375rem
		flex-shrink: 0

	&__footer-item + &__footer-item
		margin-left: 0.75rem
		padding-left: 0.75rem
		border-left: 1px solid var(--line-divider)

	&__cover
		position: relative
		flex-shrink: 0
		display: block
		overflow: hidden
		text-decoration: none
		> :global(.m3-blog-postcard__cover-loading)
			position: absolute
			inset: 0
			display: flex
			align-items: center
			justify-content: center
			background: var(--surface-container-low)
			transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(.m3-blog-postcard__cover-loading)::after
			content: ""
			width: 2rem
			aspect-ratio: 1
			border-radius: var(--shape-corner-full)
			background: var(--primary-container)
		> :global(.m3-blog-postcard__cover-loading--done)
			opacity: 0
			pointer-events: none
		> picture,
		> picture > img
			display: block
			width: 100%
			height: 100%
		> picture > img
			object-fit: cover
			position: relative

		@media (min-width: bp-md)
			position: absolute
			top: 0
			right: 0
			bottom: 0
			/* 封面占卡片右侧 5/12，不与文字层交叉；左缘 1/4（卡片 5/48）羽化融入背景 */
			width: 41.67%
			height: auto
			border-radius: 0 var(--shape-corner-l) var(--shape-corner-l) 0
			overflow: hidden
			/* 封面占卡片右侧 5/12，不与文字层交叉；左缘渐变带宽 7/48（卡片大小） */
			> picture > img
				-webkit-mask-image: linear-gradient(270deg, rgb(0,0,0) 0%, rgb(0,0,0) 65%, rgba(0,0,0,0.72) 75%, rgba(0,0,0,0.35) 83%, rgba(0,0,0,0) 100%)
				mask-image: linear-gradient(270deg, rgb(0,0,0) 0%, rgb(0,0,0) 65%, rgba(0,0,0,0.72) 75%, rgba(0,0,0,0.35) 83%, rgba(0,0,0,0) 100%)
				filter: brightness(0.92)
				transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate), filter var(--m3e-duration-medium) var(--m3e-easing-standard)
			.m3-blog-postcard:hover &
				> picture > img
					transform: scale(1.05)
					filter: brightness(1)

	/* 封面已融合为卡片背景层：不再使用 hover 深色遮罩 + 白色大箭头（已随模板移除），
	   hover 反馈 = 卡片阴影抬升 + 标题变色 + 封面图轻放大提亮 */

	&__enter
		position: absolute
		top: 0.75rem
		right: 0.75rem
		bottom: 0.75rem
		display: flex
		align-items: center
		justify-content: center
		width: 3.25rem
		border-radius: var(--shape-corner-s)
		background: var(--enter-btn-bg)
		color: var(--primary)
		text-decoration: none
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 2.25rem
			height: 2.25rem
		.m3-blog-postcard:hover &
			background: var(--enter-btn-bg-hover)
			color: var(--primary)
		@media (max-width: bp-md - 1px)
			display: none

	/* 桌面端（≥md）正文变纵向：给右侧让位（断点用 stylus 编译期常量 bp-md，
	   不能写 @media (--m3e-bp-md)：CSS 变量无法作 media 条件，该写法整块失效） */
	@media (min-width: bp-md)
		flex-direction: column
		&--cover &__body
			/* 文字右缘到卡片 7/12（渐变带中点）：避让卡片宽 5/12 */
			padding-right: 41.67%
		/* 无封面时给右侧进入按钮（3.25rem + 0.75rem 边距）预留空间，描述提前换行 */
		&:not(.m3-blog-postcard--cover) &__body
			padding-right: 4.75rem

	/* === 移动端：封面置顶布局优化（桌面端保持不动） === */
	@media (max-width: bp-md - 1px)
		/* 原始设计：标题竖线仅桌面显示 */
		.m3-blog-postcard__title :global(.m3-accent-bar)
			display: none

		/* 封面内缩置顶：四周留 1rem、2:1 宽比、0.75rem 圆角 */
		&__cover
			width: auto
			aspect-ratio: 2 / 1
			margin: 1rem 1rem 0
			border-radius: var(--shape-corner-m)
			> picture,
			> picture > img
				width: 100%
				height: 100%

		/* 正文统一 1rem 内边距 */
		&__body
			padding: 1rem

		/* 原始设计：标题尾部箭头 2rem */
		&__arrow
			width: 2rem
			height: 2rem

/* ============================================================
   容器模式联动（PostPage 的命名容器 + #post-list 类钩子）
   同一卡片按所在容器切换 token 形态，而非两套皮肤：
   - m3e-post-list--grid     封面 16:9 通栏贴边（复用移动端封面置顶语言）
   - m3e-post-list--cover-left  list 模式封面居左（桌面 ≥md 镜像布局）
   注意：钩子选择器用单个 &（自身复合），禁止 `& &`（会编译成嵌套后代，
   修饰符形式永不匹配）。
   ============================================================ */
.m3-blog-postcard
	/* —— 网格（瀑布流）模式：仅在容器确实能形成至少两列时生效 ——
	   封面内缩（与正文左右边缘对齐 --m3e-space-4，圆角 m、2:1）；
	   无封面卡片沿用 list 的右上 enter 箭头区块（正文右缘自动让位）；
	   卡片高度天然混合（有/无封面），由 PostPage 的 JS 最短列打包消除空洞 */
	grid-card-layout(shell-selector)
		/* grid 卡片固定总高度：图片 + 两行标题 + 一行分类标签 + 两行描述 + 一行日期字数时间 */
		:global({shell-selector} .m3e-post-list--grid) &
			flex-direction: column
			height: var(--post-card-grid-height, 23rem)

		/* 封面通栏贴边（参考站：图片直达卡片边缘，无内缩与圆角） */
		:global({shell-selector} .m3e-post-list--grid) &__cover
			position: relative
			inset: auto
			width: 100%
			height: var(--post-card-grid-cover-height, 10.5rem)
			aspect-ratio: auto
			margin: 0
			border-radius: 0
			flex-shrink: 0
