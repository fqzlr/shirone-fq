			pointer-events: none

		:global(html.dark) .banner-stage__scrim
			background: unquote("rgb(0 0 0 / var(--banner-dim-opacity))")

		.banner-stage__copy
			z-index: 2
			display: none
			flex-direction: column
			align-items: center
			justify-content: center
			padding: 4rem 1.5rem 2rem
			color: white
			text-align: center
			text-shadow: 0 2px 12px rgba(0, 0, 0, 0.48)
			pointer-events: none

		.banner-stage__copy h1,
		.banner-stage__context-title
			margin: 0
			font: var(--m3e-type-headline-medium)
			font-weight: 700
			letter-spacing: 0
			line-height: 1.1

		.banner-stage__copy h1,
		.banner-stage__context-title
			font-size: clamp(2.5rem, 5rem, 5rem)

		.banner-stage__copy--home p
			margin-top: 0.75rem
			font: var(--m3e-type-headline-small)

			&[data-subtitle-state="typing"]::after
				content: ""
				display: inline-block
				width: 0.08em
				height: 1em
				margin-inline-start: 0.12em
				vertical-align: -0.12em
				background: currentColor
				animation: banner-subtitle-caret var(--m3e-duration-long) steps(1, end) infinite

		/* 首页标题下快捷入口：文字胶囊 / 圆形图标按钮（图像上的可读性白玻璃样式） */
		.banner-stage__links
			display: flex
			flex-wrap: wrap
			align-items: center
			justify-content: center
			gap: 0.75rem
			margin-top: 1.25rem
			pointer-events: auto

		.banner-stage__link
			display: inline-flex
			align-items: center
