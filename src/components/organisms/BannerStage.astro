---
import { getImage } from "astro:assets";
import BannerWaves from "@components/molecules/BannerWaves.astro";
import { resolveImageAsset } from "@utils/asset-utils";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";

interface Props {
	page?: SidebarPage;
	title?: string;
	description?: string;
	date?: string;
}

const { page, title = "", description = "", date = "" } = Astro.props;
const normalizedTitle = title.trim();
const normalizedDescription = description.trim();
const initialSupportingText =
	normalizedDescription !== normalizedTitle ? normalizedDescription : "";
const initialDate = date.trim();
const initialCopyMode =
	page === "home" ? "home" : page && normalizedTitle ? "context" : "none";
const initialLabel =
	initialCopyMode === "context"
		? normalizedTitle
		: siteConfig.banner.homeText.title;

interface ResponsiveBannerImage {
	fallback: string;
	avifSrcset: string;
	webpSrcset: string;
	width?: number;
	height?: number;
}

const optimizeBannerImage = async (
	src: string,
	viewport: "desktop" | "mobile",
): Promise<ResponsiveBannerImage> => {
	const resolved = await resolveImageAsset(src);
	if (typeof resolved === "string") {
		return {
			fallback: resolved.startsWith("/") ? url(resolved) : resolved,
			avifSrcset: "",
			webpSrcset: "",
		};
	}

	const requestedWidths =
		viewport === "desktop" ? [1280, 1600, 1920] : [640, 828, 1080];
	const widths = [
		...new Set([
			...requestedWidths.filter((width) => width <= resolved.width),
			Math.min(requestedWidths.at(-1) ?? resolved.width, resolved.width),
		]),
	].sort((a, b) => a - b);
	const createCandidates = async (format: "avif" | "webp", quality: number) =>
		Promise.all(
			widths.map(async (width) => ({
				width,
				image: await getImage({ src: resolved, width, format, quality }),
			})),
		);
	const [avif, webp] = await Promise.all([
		createCandidates("avif", 55),
		createCandidates("webp", 68),
	]);
	const fallback = webp.at(-1)?.image.src ?? resolved.src;
	return {
		fallback,
		avifSrcset: avif
			.map(({ image, width }) => `${image.src} ${width}w`)
			.join(", "),
		webpSrcset: webp
			.map(({ image, width }) => `${image.src} ${width}w`)
			.join(", "),
		width: resolved.width,
		height: resolved.height,
	};
};

const desktopResponsiveImages = await Promise.all(
	siteConfig.banner.src.desktop.map((src) =>
		optimizeBannerImage(src, "desktop"),
	),
);
const mobileResponsiveImages = await Promise.all(
	siteConfig.banner.src.mobile.map((src) => optimizeBannerImage(src, "mobile")),
);
const desktopImages = desktopResponsiveImages.map(({ fallback }) => fallback);
const mobileImages = mobileResponsiveImages.map(({ fallback }) => fallback);
const dimOpacity = Math.min(Math.max(siteConfig.banner.dim.opacity, 0), 1);
const rawSubtitles = siteConfig.banner.homeText.subtitle;
const subtitleArray = Array.isArray(rawSubtitles)
	? rawSubtitles
	: [rawSubtitles];
const defaultInitialSubtitle = subtitleArray[0] ?? "";
const typewriter = siteConfig.banner.homeText.typewriter;
const carouselFadeDuration = Math.min(
	Math.max(siteConfig.banner.carousel?.fadeDuration ?? 1200, 300),
	3000,
);
const carouselAnimation = siteConfig.banner.carousel?.animation ?? "ken-burns";
const initialDesktopSrc = desktopImages[0] ?? "";
const initialMobileSrc = mobileImages[0] ?? "";
const initialSrc = initialDesktopSrc || initialMobileSrc;
const initialDesktopImage = desktopResponsiveImages[0];
const initialMobileImage = mobileResponsiveImages[0];
const initialImage = initialDesktopImage ?? initialMobileImage;
const initialMobileBanner = page === "home";
const homeLinks = (siteConfig.banner.homeText.links ?? []).filter(
	(link) => link.icon && link.url,
);
const videoEnabled = Boolean(
	siteConfig.banner.video?.enable &&
		(siteConfig.banner.video.src?.length ?? 0) > 0,
);
const videoSrcs = videoEnabled
	? siteConfig.banner.video?.src.map((src) =>
			src.startsWith("/") ? url(src) : src,
		)
	: [];
const videoMode =
	siteConfig.banner.video?.mode === "random" ? "random" : "order";
---

<section
	id="banner-wrapper"
	class="banner-stage"
	aria-label={initialLabel}
	data-copy-mode={initialCopyMode}
	data-context-motion="idle"
	data-desktop-images={JSON.stringify(desktopImages)}
	data-mobile-images={JSON.stringify(mobileImages)}
	data-carousel-enabled={String(siteConfig.banner.carousel.enable)}
	data-carousel-interval={String(Math.max(siteConfig.banner.carousel.interval, 3000))}
	data-carousel-fade-duration={String(carouselFadeDuration)}
	data-carousel-animation={carouselAnimation}
	style={`--banner-fade-duration: ${carouselFadeDuration}ms;`}
	data-position={siteConfig.banner.position ?? "center"}
	data-home-title={siteConfig.banner.homeText.title}
	data-home-subtitles={JSON.stringify(subtitleArray)}
	data-subtitle-typewriter-enabled={String(typewriter.enable)}
	data-subtitle-typewriter-loop={String(typewriter.loop)}
	data-subtitle-typewriter-speed={String(Math.max(typewriter.speed, 1))}
	data-subtitle-typewriter-delete-speed={String(Math.max(typewriter.deleteSpeed ?? 50, 1))}
	data-subtitle-typewriter-pause-time={String(Math.max(typewriter.pauseTime ?? 2000, 0))}
	data-video-enabled={String(videoEnabled)}
	data-video-srcs={JSON.stringify(videoSrcs)}
	data-video-mode={videoMode}
>
	<div class="banner-stage__media" aria-hidden="true">
		<picture>
			{initialDesktopImage?.avifSrcset && (
				<source media="(min-width: 1024px)" type="image/avif" srcset={initialDesktopImage.avifSrcset} sizes="100vw" />
			)}
			{initialDesktopImage?.webpSrcset && (
				<source media="(min-width: 1024px)" type="image/webp" srcset={initialDesktopImage.webpSrcset} sizes="100vw" />
			)}
			{initialDesktopImage && !initialDesktopImage.avifSrcset && !initialDesktopImage.webpSrcset && (
				<source media="(min-width: 1024px)" srcset={initialDesktopImage.fallback} />
			)}
			{initialMobileBanner && initialMobileImage?.avifSrcset && (
				<source media="(max-width: 1023.98px)" type="image/avif" srcset={initialMobileImage.avifSrcset} sizes="100vw" />
			)}
			{initialMobileBanner && initialMobileImage?.webpSrcset && (
				<source media="(max-width: 1023.98px)" type="image/webp" srcset={initialMobileImage.webpSrcset} sizes="100vw" />
			)}
			{initialMobileBanner && initialMobileImage && !initialMobileImage.avifSrcset && !initialMobileImage.webpSrcset && (
				<source media="(max-width: 1023.98px)" srcset={initialMobileImage.fallback} />
			)}
			<img
				class="banner-stage__image banner-stage__image--front banner-stage__image--active"
				src={initialMobileBanner ? initialSrc || undefined : undefined}
				width={initialImage?.width}
				height={initialImage?.height}
				fetchpriority="high"
				loading="eager"
				decoding="async"
				alt=""
				style={`object-position: ${siteConfig.banner.position ?? "center"};`}
			/>
		</picture>
		<img class="banner-stage__image banner-stage__image--back" alt="" />
		</div>
		{videoEnabled && (
			<video
				class="banner-stage__video"
				data-banner-video
				muted
				playsinline
				preload="none"
				aria-hidden="true"
				style={`object-position: ${siteConfig.banner.position ?? "center"};`}
			></video>
		)}
		{siteConfig.banner.dim.enable && (
			<div class="banner-stage__scrim" style={`--banner-dim-opacity: ${dimOpacity}`}></div>
		)}
		{siteConfig.banner.homeText.enable && (
			<div class="banner-stage__copy banner-stage__copy--home" data-banner-home-copy>
				<h1>{siteConfig.banner.homeText.title}</h1>
				<p
					aria-label={defaultInitialSubtitle}
					data-subtitle-state="complete"
				>
					{defaultInitialSubtitle}
				</p>
				{homeLinks.length > 0 && (
					<nav class="banner-stage__links" aria-label={siteConfig.banner.homeText.title}>
						{homeLinks.map((link) => {
							const href = link.url.startsWith("/") ? url(link.url) : link.url;
							const external = link.external ?? /^https?:\/\//.test(link.url);
							const label = link.ariaLabel ?? link.text;
						const linkClass = `banner-stage__link${link.text ? "" : " banner-stage__link--icon"}`;
						return external ? (
							<a class={linkClass} href={href} target="_blank" rel="noreferrer noopener" aria-label={label} title={link.text ?? label}>
								<Icon name={link.icon} aria-hidden="true" />
								{link.text && <span>{link.text}</span>}
							</a>
						) : (
							<a class={linkClass} href={href} aria-label={label} title={link.text ?? label}>
								<Icon name={link.icon} aria-hidden="true" />
								{link.text && <span>{link.text}</span>}
							</a>
						);
						})}
					</nav>
				)}
			</div>
		)}
	<div class="banner-stage__copy banner-stage__copy--context" data-banner-context>
		<div class="banner-stage__context-title" data-banner-context-title>
			{normalizedTitle}
		</div>
		<div
			class="banner-stage__context-details"
			data-banner-context-details
			hidden={!initialSupportingText && !initialDate}
		>
			<span class="banner-stage__context-divider" aria-hidden="true"></span>
			<p
				class="banner-stage__context-description"
				data-banner-context-description
				hidden={!initialSupportingText}
			>
				<span
					class="banner-stage__context-quote banner-stage__context-quote--start"
					aria-hidden="true"
				>
					<Icon name="material-symbols:format-quote-rounded" />
				</span>
				<span class="banner-stage__context-text" data-banner-context-text>
					{initialSupportingText}
				</span>
				<span
					class="banner-stage__context-quote banner-stage__context-quote--end"
					aria-hidden="true"
				>
					<Icon name="material-symbols:format-quote-rounded" />
				</span>
			</p>
			<div class="banner-stage__context-meta" data-banner-context-meta hidden={!initialDate}>
				<Icon name="material-symbols:calendar-today-rounded" aria-hidden="true" />
				<time data-banner-context-date datetime={initialDate}>{initialDate}</time>
			</div>
		</div>
	</div>
	{siteConfig.banner.waves.enable && <BannerWaves />}
	<div class="banner-stage__gradient" aria-hidden="true"></div>
	{page === "home" && (
		<button
			type="button"
			class="banner-stage__scroll-down"
			data-banner-scroll-down
			aria-label="向下滚动查看内容"
		>
			<Icon name="material-symbols:keyboard-arrow-down-rounded" aria-hidden="true" />
		</button>
	)}
</section>

<script>
	import { resolveBannerState, type BannerViewport } from "@utils/banner-state";
	import {
		playBannerMotion,
		type BannerAnimationHandle,
		type BannerAnimationPreset,
	} from "@utils/banner-animation";
	import {
		EASING_ACCELERATE,
		EASING_DECELERATE,
		prefersReducedMotion,
	} from "@utils/motion";
	import { getStoredFullscreenLayout, getStoredWallpaperMode } from "@utils/setting-utils";
	import {
		BANNER_CAROUSEL_CHANGE_EVENT,
		BANNER_GRADIENT_CHANGE_EVENT,
		BANNER_TITLE_CHANGE_EVENT,
		BANNER_VIDEO_STATE_CHANGE_EVENT,
		BANNER_VIDEO_TOGGLE_EVENT,
		BANNER_WAVES_CHANGE_EVENT,
		WALLPAPER_FULLSCREEN_LAYOUT_CHANGE_EVENT,
		WALLPAPER_MODE_CHANGE_EVENT,
	} from "@constants/constants";
	import type { SidebarPage } from "@/types/sidebarConfig";

	interface BannerRuntime {
		activeGroup: BannerViewport | null;
		activeIndex: number;
		activeLayer: 0 | 1;
		images: Record<BannerViewport, string[]>;
		preloaded: HTMLImageElement | null;
		subtitleGeneration: number;
		subtitlePage: SidebarPage | null;
		subtitleTimer: number | null;
		subtitleVisible: boolean;
		contextAnimation: Animation | null;
		contextTransitionPending: boolean;
		titleFitFrame: number | null;
		navigationSyncFrame: number | null;
		timer: number | null;
		layerMotions: [BannerAnimationHandle | null, BannerAnimationHandle | null];
	}

	declare global {
		interface Window {
			__shironeBannerBound?: boolean;
		}
	}

	const stage = document.getElementById("banner-wrapper") as HTMLElement | null;
	const layers = stage
		? [...stage.querySelectorAll<HTMLImageElement>(".banner-stage__image")]
		: [];
	const subtitle = stage?.querySelector<HTMLParagraphElement>(
		"[data-banner-home-copy] p",
	);
	const contextTitle = stage?.querySelector<HTMLElement>(
		"[data-banner-context-title]",
	);
	const contextDescription = stage?.querySelector<HTMLElement>(
		"[data-banner-context-description]",
	);
	const contextDetails = stage?.querySelector<HTMLElement>(
		"[data-banner-context-details]",
	);
	const contextMeta = stage?.querySelector<HTMLElement>(
		"[data-banner-context-meta]",
	);
	const contextDate = stage?.querySelector<HTMLTimeElement>(
		"[data-banner-context-date]",
	);
	const runtime: BannerRuntime = {
		activeGroup: null,
		activeIndex: 0,
		activeLayer: 0,
		images: {
			desktop: parseImages(stage?.dataset.desktopImages),
			mobile: parseImages(stage?.dataset.mobileImages),
		},
		preloaded: null,
		subtitleGeneration: 0,
		subtitlePage: null,
		subtitleTimer: null,
		subtitleVisible: false,
		contextAnimation: null,
		contextTransitionPending: false,
		titleFitFrame: null,
		navigationSyncFrame: null,
		timer: null,
		layerMotions: [null, null],
	};

	function parseImages(value: string | undefined): string[] {
		if (!value) return [];
		try {
			const parsed = JSON.parse(value);
			return Array.isArray(parsed)
				? parsed.filter((item): item is string => typeof item === "string")
				: [];
		} catch {
			return [];
		}
	}

	function currentPage(): SidebarPage | undefined {
		return document.getElementById("swup-container")?.dataset.currentPage as
			| SidebarPage
			| undefined;
	}

	/** 轮播开关：访客偏好（html data-*）优先，未设置时回退站点配置默认值 */
	function isCarouselEnabled(): boolean {
		const attr = document.documentElement.dataset.bannerCarouselEnabled;
		if (attr !== undefined) return attr === "true";
		return stage?.dataset.carouselEnabled === "true";
	}

	function currentViewport(): BannerViewport {
		return window.matchMedia("(min-width: 1024px)").matches
			? "desktop"
			: "mobile";
	}

	function stopRotation() {
		if (runtime.timer !== null) window.clearTimeout(runtime.timer);
		runtime.timer = null;
	}

	function subtitleSegments(value: string): string[] {
		if (typeof Intl.Segmenter === "function") {
			const segmenter = new Intl.Segmenter(undefined, {
				granularity: "grapheme",
			});
			return [...segmenter.segment(value)].map(({ segment }) => segment);
		}
		return Array.from(value);
	}

	function getSubtitleTexts(): string[] {
		try {
			const parsed = JSON.parse(stage?.dataset.homeSubtitles || "[]");
			if (Array.isArray(parsed) && parsed.length > 0) {
				return parsed.filter(Boolean);
			}
		} catch {
			// ignore
		}
		const initial =
			subtitle?.getAttribute("aria-label") || subtitle?.textContent || "";
		return initial ? [initial] : [];
	}

	function stopSubtitleTyping() {
		runtime.subtitleGeneration += 1;
		if (runtime.subtitleTimer !== null) {
			window.clearTimeout(runtime.subtitleTimer);
		}
		runtime.subtitleTimer = null;
		runtime.subtitleVisible = false;
		if (subtitle) {
			const texts = getSubtitleTexts();
			subtitle.textContent = texts[0] || "";
			subtitle.dataset.subtitleState = "complete";
		}
	}

	function showSubtitleImmediately() {
		stopSubtitleTyping();
		runtime.subtitleVisible = true;
		if (subtitle) {
			const texts = getSubtitleTexts();
			subtitle.textContent = texts[0] || "";
			subtitle.dataset.subtitleState = "complete";
		}
	}

	function readMotionDuration(property: string, fallback: number): number {
		const value = Number.parseFloat(
			getComputedStyle(document.documentElement).getPropertyValue(property),
		);
		return Number.isFinite(value) && value > 0 ? value : fallback;
	}

	function startSubtitleTyping(page: SidebarPage | undefined) {
		if (!subtitle || !page || page !== "home") {
			stopSubtitleTyping();
			runtime.subtitlePage = page ?? null;
			return;
		}

		if (
			runtime.subtitlePage === page &&
			runtime.subtitleVisible &&
			!(prefersReducedMotion() && subtitle.dataset.subtitleState === "typing")
		)
			return;
		runtime.subtitlePage = page;
		if (
			stage?.dataset.subtitleTypewriterEnabled !== "true" ||
			prefersReducedMotion()
		) {
			showSubtitleImmediately();
			return;
		}

		runtime.subtitleGeneration += 1;
		const generation = runtime.subtitleGeneration;
		if (runtime.subtitleTimer !== null) {
			window.clearTimeout(runtime.subtitleTimer);
		}
		runtime.subtitleTimer = null;
		runtime.subtitleVisible = true;

		const texts = getSubtitleTexts();
		if (!texts.length) {
			subtitle.textContent = "";
			subtitle.dataset.subtitleState = "complete";
			return;
		}

		const loop = stage?.dataset.subtitleTypewriterLoop === "true";
		const configuredSpeed = Number.parseFloat(
			stage?.dataset.subtitleTypewriterSpeed || "120",
		);
		const speed = Number.isFinite(configuredSpeed)
			? Math.max(configuredSpeed, 1)
			: 120;
		const configuredDeleteSpeed = Number.parseFloat(
			stage?.dataset.subtitleTypewriterDeleteSpeed || "50",
		);
		const deleteSpeed = Number.isFinite(configuredDeleteSpeed)
			? Math.max(configuredDeleteSpeed, 1)
			: 50;
		const configuredPauseTime = Number.parseFloat(
			stage?.dataset.subtitleTypewriterPauseTime || "2000",
		);
		const pauseTime = Number.isFinite(configuredPauseTime)
			? Math.max(configuredPauseTime, 0)
			: 2000;

		let textIndex = 0;
		let charIndex = 0;
		let isDeleting = false;
		subtitle.textContent = "";
		subtitle.dataset.subtitleState = "typing";

		const step = () => {
			if (generation !== runtime.subtitleGeneration || !subtitle) return;

			const currentText = texts[textIndex] || "";
			const segments = subtitleSegments(currentText);

			if (isDeleting) {
				if (charIndex > 0) {
					charIndex -= 1;
					subtitle.textContent = segments.slice(0, charIndex).join("");
					runtime.subtitleTimer = window.setTimeout(step, deleteSpeed);
				} else {
					// 当前句子已反向回退完毕，切换至下一条并开始正向打字
					isDeleting = false;
					textIndex = (textIndex + 1) % texts.length;
					runtime.subtitleTimer = window.setTimeout(step, speed);
				}
			} else {
				if (charIndex < segments.length) {
					charIndex += 1;
					subtitle.textContent = segments.slice(0, charIndex).join("");
					runtime.subtitleTimer = window.setTimeout(step, speed);
				} else {
					// 当前句子完整打字呈现
					subtitle.dataset.subtitleState = "complete";
					// 若配置了多句或者启用了循环回退
					if (texts.length > 1 || loop) {
						isDeleting = true;
						runtime.subtitleTimer = window.setTimeout(() => {
							if (generation !== runtime.subtitleGeneration || !subtitle) return;
							subtitle.dataset.subtitleState = "typing";
							step();
						}, pauseTime);
					} else {
						runtime.subtitleTimer = null;
					}
				}
			}
		};

		step();
	}

	function preloadNext(images: string[], index: number) {
		if (images.length < 2) return;
		const schedulePreload = () => {
			const load = () => {
				runtime.preloaded = new Image();
				runtime.preloaded.src = images[(index + 1) % images.length];
			};
			if (typeof window.requestIdleCallback === "function") {
				window.requestIdleCallback(load, { timeout: 3000 });
			} else {
				window.setTimeout(load, 1500);
			}
		};
		const current = layers[runtime.activeLayer];
		if (current && !current.complete) {
			current.addEventListener("load", schedulePreload, { once: true });
		} else {
			schedulePreload();
		}
	}

	function getCarouselInterval(): number {
		return Math.max(
			Number.parseInt(stage?.dataset.carouselInterval || "6000", 10),
			3000,
		);
	}

	function getFadeDuration(): number {
		return Math.max(
			Number.parseInt(stage?.dataset.carouselFadeDuration || "1200", 10),
			300,
		);
	}

	function getAnimationPreset(): BannerAnimationPreset {
		return (
			(stage?.dataset.carouselAnimation as BannerAnimationPreset) ||
			"ken-burns"
		);
	}

	function stopLayerMotions() {
		runtime.layerMotions[0]?.cancel();
		runtime.layerMotions[0] = null;
		runtime.layerMotions[1]?.cancel();
		runtime.layerMotions[1] = null;
	}

	function pauseLayerMotions() {
		runtime.layerMotions[0]?.pause();
		runtime.layerMotions[1]?.pause();
	}

	function resumeLayerMotions() {
		runtime.layerMotions[0]?.resume();
		runtime.layerMotions[1]?.resume();
	}

	function showImage(src: string, immediate: boolean) {
		if (!layers.length) return;
		const nextLayer = immediate ? runtime.activeLayer : runtime.activeLayer === 0 ? 1 : 0;
		const next = layers[nextLayer];
		const previous = layers[runtime.activeLayer];
		if (next.src !== new URL(src, window.location.href).href) next.src = src;
		next.style.objectPosition = stage?.dataset.position || "center";

		const interval = getCarouselInterval();
		const fadeDuration = getFadeDuration();
		const motionDuration = interval + fadeDuration;
		const preset = getAnimationPreset();

		runtime.layerMotions[nextLayer]?.cancel();
		const startMotion = () => {
			if (runtime.activeLayer !== nextLayer || prefersReducedMotion()) return;
			runtime.layerMotions[nextLayer]?.cancel();
			runtime.layerMotions[nextLayer] = playBannerMotion({
				element: next,
				preset,
				index: runtime.activeIndex,
				durationMs: motionDuration,
			});
		};

		if (immediate || prefersReducedMotion()) {
			for (let i = 0; i < layers.length; i += 1) {
				if (i !== nextLayer) {
					layers[i].classList.remove("banner-stage__image--active");
					layers[i].classList.remove("banner-stage__image--fading");
					runtime.layerMotions[i]?.cancel();
					runtime.layerMotions[i] = null;
				}
			}
			next.classList.add("banner-stage__image--active");
			next.classList.remove("banner-stage__image--fading");
		} else {
			next.classList.add("banner-stage__image--active");
			next.classList.add("banner-stage__image--fading");
			previous.classList.remove("banner-stage__image--active");
			previous.classList.add("banner-stage__image--fading");
		}
		runtime.activeLayer = nextLayer;
		if (!immediate) startMotion();
	}

	function scheduleRotation(images: string[]) {
		stopRotation();
		const delay = Number.parseInt(stage?.dataset.carouselInterval || "6000", 10);
		runtime.timer = window.setTimeout(() => {
			runtime.activeIndex = (runtime.activeIndex + 1) % images.length;
			showImage(images[runtime.activeIndex], false);
			preloadNext(images, runtime.activeIndex);
			syncBanner();
		}, delay);
	}

	function canAnimateBannerContext(): boolean {
		return (
			currentViewport() === "desktop" &&
			stage?.hidden === false &&
			!prefersReducedMotion()
		);
	}

	function settleContextAnimation() {
		runtime.contextAnimation?.cancel();
		runtime.contextAnimation = null;
		if (!stage) return;
		stage.dataset.contextMotion = "idle";
	}

	function animateContextOut() {
		runtime.contextTransitionPending = canAnimateBannerContext();
		settleContextAnimation();
		if (
			!runtime.contextTransitionPending ||
			stage?.dataset.copyMode !== "context" ||
			!contextTitle
		)
			return;
		const copy = contextTitle.closest<HTMLElement>("[data-banner-context]");
		if (!copy) return;
		stage!.dataset.contextMotion = "out";
		runtime.contextAnimation = copy.animate(
			[
				{ opacity: 1, transform: "translate(-50%, -50%) translateY(0)" },
				{ opacity: 0, transform: "translate(-50%, -50%) translateY(-0.25rem)" },
			],
			{
				duration: readMotionDuration("--m3e-duration-short", 150),
				easing: EASING_ACCELERATE,
				fill: "forwards",
			},
		);
	}

	function animateContextIn() {
		const shouldAnimate =
			runtime.contextTransitionPending &&
			canAnimateBannerContext() &&
			stage?.dataset.copyMode === "context";
		runtime.contextTransitionPending = false;
		settleContextAnimation();
		if (!shouldAnimate || !contextTitle) return;
		const copy = contextTitle.closest<HTMLElement>("[data-banner-context]");
		if (!copy) return;
		stage!.dataset.contextMotion = "in";
		runtime.contextAnimation = copy.animate(
			[
				{ opacity: 0, transform: "translate(-50%, -50%) translateY(0.25rem)" },
				{ opacity: 1, transform: "translate(-50%, -50%) translateY(0)" },
			],
			{
				duration: readMotionDuration("--m3e-duration-medium", 250),
				easing: EASING_DECELERATE,
			},
		);
		runtime.contextAnimation.onfinish = settleContextAnimation;
		runtime.contextAnimation.oncancel = () => {
			runtime.contextAnimation = null;
		};
	}

	function fitContextTitle() {
		if (!contextTitle || !stage || stage.dataset.copyMode !== "context") return;
		contextTitle.style.removeProperty("font-size");
		contextTitle.dataset.titleFit = "full";
		if (contextTitle.scrollWidth <= contextTitle.clientWidth) return;

		const rootFontSize = Number.parseFloat(
			getComputedStyle(document.documentElement).fontSize,
		);
		const maximum = Number.parseFloat(getComputedStyle(contextTitle).fontSize);
		const minimum = Number.isFinite(rootFontSize) ? rootFontSize * 2.25 : 36;
		let lower = Math.min(minimum, maximum);
		let upper = maximum;

		contextTitle.dataset.titleFit = "scaled";
		for (let step = 0; step < 8; step += 1) {
			const candidate = (lower + upper) / 2;
			contextTitle.style.fontSize = `${candidate}px`;
			if (contextTitle.scrollWidth <= contextTitle.clientWidth) lower = candidate;
			else upper = candidate;
		}
		contextTitle.style.fontSize = `${lower}px`;
		if (contextTitle.scrollWidth > contextTitle.clientWidth) {
			contextTitle.style.removeProperty("font-size");
			contextTitle.dataset.titleFit = "wrapped";
		}
	}

	function scheduleContextTitleFit() {
		if (runtime.titleFitFrame !== null) {
			window.cancelAnimationFrame(runtime.titleFitFrame);
		}
		runtime.titleFitFrame = window.requestAnimationFrame(() => {
			runtime.titleFitFrame = null;
			fitContextTitle();
		});
	}

	interface BannerContext {
		title: string;
		description: string;
		date: string;
	}

	function readContext(): BannerContext {
		const container = document.getElementById("swup-container");
		return {
			title: container?.dataset.bannerTitle?.trim() || "",
			description: container?.dataset.bannerDescription?.trim() || "",
			date: container?.dataset.bannerDate?.trim() || "",
		};
	}

	function syncContext(context: BannerContext) {
		if (
			!stage ||
			!contextTitle ||
			!contextDescription ||
			!contextDetails ||
			!contextMeta ||
			!contextDate
		)
			return false;
		const title = context.title;
		const description = context.description !== title ? context.description : "";
		const date = context.date;
		contextTitle.style.removeProperty("font-size");
		contextTitle.dataset.titleFit = "full";
		contextTitle.textContent = title;
		// 描述文本在内层 span 上改写：外层是引言框（含首尾引号装饰图标）
		const descriptionText = contextDescription.querySelector<HTMLElement>(
			"[data-banner-context-text]",
		);
		if (descriptionText) descriptionText.textContent = description;
		contextDescription.hidden = !description;
		contextDate.textContent = date;
		contextDate.dateTime = date;
		contextMeta.hidden = !date;
		contextDetails.hidden = !description && !date;
		scheduleContextTitleFit();
		return Boolean(title);
	}

	function syncBanner(pageOverride?: SidebarPage, contextOverride?: BannerContext) {
		if (!stage) return;
		const viewport = currentViewport();
		const images = runtime.images[viewport];
		const page = pageOverride ?? currentPage();
		const context = contextOverride ?? readContext();
		const state = resolveBannerState({
			mode: getStoredWallpaperMode(),
			fullscreenLayout: getStoredFullscreenLayout(),
			page,
			viewport,
			imageCount: images.length,
			carouselEnabled: isCarouselEnabled(),
			reducedMotion: prefersReducedMotion(),
			contextTitle: context.title,
		});

		document.body.dataset.currentPage = page || "";
		document.body.dataset.bannerVisible = String(state.visible);
		document.body.dataset.bannerLayout = state.contentLayout;
		document.body.dataset.bannerTopAppBar = String(state.transparentTopAppBar);
		stage.hidden = !state.visible;
		if (stage.hidden) pauseBannerVideo();
		const hasContext =
			state.copyMode === "context" && syncContext(context);
		const copyMode = state.copyMode === "home" ? "home" : hasContext ? "context" : "none";
		stage.dataset.copyMode = copyMode;
		stage.setAttribute(
			"aria-label",
			copyMode === "context"
				? contextTitle?.textContent || ""
				: stage.dataset.homeTitle || "",
		);
		if (copyMode === "home") startSubtitleTyping(page);
		else stopSubtitleTyping();

		if (!state.visible || !state.assetGroup) {
			stopRotation();
			stopLayerMotions();
			return;
		}

		if (runtime.activeGroup !== state.assetGroup) {
			runtime.activeGroup = state.assetGroup;
			runtime.activeIndex = 0;
			showImage(images[0], true);
			layers[runtime.activeLayer]?.setAttribute("fetchpriority", "high");
			preloadNext(images, 0);
		}

		if (state.rotate && !document.hidden) scheduleRotation(images);
		else stopRotation();
	}

	function scheduleNavigationSync(animateIn = false) {
		if (runtime.navigationSyncFrame !== null) {
			window.cancelAnimationFrame(runtime.navigationSyncFrame);
		}
		runtime.navigationSyncFrame = window.requestAnimationFrame(() => {
			runtime.navigationSyncFrame = null;
			syncBanner();
			updateHeroTitleParallax();
			if (animateIn) animateContextIn();
		});
	}

	// ---------------------------------------------------------------------
	// 横幅背景视频：悬浮控制流（FAB）↔ 舞台视频元素。
	// preload="none"——首次点击播放才发起视频请求；播放期间挂起图片轮播，
	// 暂停后恢复；多源按 order/random 自动接续；舞台隐藏（纯色模式等）即暂停。
	// ---------------------------------------------------------------------
	const video = stage?.querySelector<HTMLVideoElement>("[data-banner-video]");
	const videoSrcs = parseImages(stage?.dataset.videoSrcs);
	const videoMode = stage?.dataset.videoMode === "random" ? "random" : "order";
	let videoIndex = 0;

	function dispatchVideoState(playing: boolean) {
		window.dispatchEvent(
			new CustomEvent(BANNER_VIDEO_STATE_CHANGE_EVENT, {
				detail: { playing },
			}),
		);
	}

	function pauseBannerVideo() {
		if (video && !video.paused) video.pause();
	}

	function advanceVideoSource(offset: number) {
		if (!video || videoSrcs.length === 0) return;
		if (videoSrcs.length === 1) {
			videoIndex = 0;
		} else if (videoMode === "random") {
			// 随机接续时避免与当前源重复
			let next = videoIndex;
			while (next === videoIndex) {
				next = Math.floor(Math.random() * videoSrcs.length);
			}
			videoIndex = next;
		} else {
			videoIndex = (videoIndex + offset + videoSrcs.length) % videoSrcs.length;
		}
		video.src = videoSrcs[videoIndex];
	}

	async function playBannerVideo() {
		if (!video || stage?.hidden) return;
		if (!video.src) advanceVideoSource(0);
		try {
			await video.play();
		} catch {
			// 自动播放策略拒绝（理论上静音可播）或源不可用：回退到暂停态
			dispatchVideoState(false);
		}
	}

	function toggleBannerVideo() {
		if (!video) return;
		if (video.paused) void playBannerVideo();
		else video.pause();
	}

	if (video) {
		// 单源循环播放；多源由 ended 事件按模式接续
		video.loop = videoSrcs.length === 1;
		video.addEventListener("play", () => {
			video.classList.add("banner-stage__video--active");
			// 视频成为视觉主体：挂起图片轮播与运镜
			stopRotation();
			stopLayerMotions();
			dispatchVideoState(true);
		});
		video.addEventListener("pause", () => {
			video.classList.remove("banner-stage__video--active");
			dispatchVideoState(false);
			if (!stage?.hidden) syncBanner();
		});
		video.addEventListener("ended", () => {
			advanceVideoSource(1);
			void playBannerVideo();
		});
		video.addEventListener("error", () => {
			dispatchVideoState(false);
		});
		window.addEventListener(BANNER_VIDEO_TOGGLE_EVENT, () => toggleBannerVideo());
	}

	// ---------------------------------------------------------------------
	// 全屏壁纸 hero 布局：横幅文案（首页标题 / 非首页上下文标题）随滚动平滑
	// 上移并淡出（壁纸保持 fixed，文案以滚动速度上移、滚动半个视口后完全
	// 透明，与参考站一致）。其余模式 / 过渡期一律复位，交还 CSS 控制。
	// ---------------------------------------------------------------------
	const HERO_TITLE_FADE_RATIO = 0.5;
	let heroParallaxTicking = false;
	let lastHeroTransform = "";
	let lastHeroOpacity = "";

	function isHeroTitleParallaxActive(): boolean {
		const html = document.documentElement;
		return (
			html.dataset.wallpaperMode === "fullscreen" &&
			html.dataset.fullscreenLayout === "hero"
		);
	}

	/** 记忆化写入：值未变化时跳过合成层属性的逐帧更新。
	 *  首页写 home 文案；非首页写上下文文案（保留其 CSS 居中位移前缀） */
	function applyHeroTitleParallax(transform: string, opacity: string) {
		if (transform === lastHeroTransform && opacity === lastHeroOpacity) return;
		lastHeroTransform = transform;
		lastHeroOpacity = opacity;
		const homeCopy = stage?.querySelector<HTMLElement>(
			"[data-banner-home-copy]",
		);
		if (homeCopy) {
			homeCopy.style.transform = transform;
			homeCopy.style.opacity = opacity;
		}
		const contextCopy = stage?.querySelector<HTMLElement>(
			"[data-banner-context]",
		);
		if (contextCopy) {
			contextCopy.style.transform = transform
				? `translate(-50%, -50%) ${transform}`
				: "";
			contextCopy.style.opacity = opacity;
		}
	}

	function updateHeroTitleParallax() {
		heroParallaxTicking = false;
		if (!isHeroTitleParallaxActive()) {
			applyHeroTitleParallax("", "");
			return;
		}
		const scrollY = window.scrollY;
		// Math.max 防零视口（极端环境 innerHeight=0 时避免 0/0=NaN 写入非法透明度）
		const fadeScroll = Math.max(window.innerHeight * HERO_TITLE_FADE_RATIO, 1);
		const ratio = Math.min(scrollY / fadeScroll, 1);
		applyHeroTitleParallax(`translateY(${-scrollY}px)`, String(1 - ratio));
	}

	function requestHeroTitleParallax() {
		if (heroParallaxTicking) return;
		heroParallaxTicking = true;
		window.requestAnimationFrame(updateHeroTitleParallax);
	}

	// ---------------------------------------------------------------------
	// 全屏壁纸 classic 布局：首屏底部只留下滑箭头，水波纹/渐变过渡在滚动后
	// 才淡入。滚过阈值后箭头淡出，body[data-banner-reveal] 驱动波浪/渐变
	// 淡入；其余模式一律复位（箭头由 CSS 控制仅 classic 首页显示）。
	// ---------------------------------------------------------------------
	const CLASSIC_SCROLL_REVEAL_THRESHOLD = 100;
	let classicScrollTicking = false;

	function isClassicHomeLayout(): boolean {
		const html = document.documentElement;
		return (
			html.dataset.wallpaperMode === "fullscreen" &&
			html.dataset.fullscreenLayout === "classic" &&
			document.body.dataset.currentPage === "home"
		);
	}

	function updateClassicScrollState() {
		classicScrollTicking = false;
		const scrollDown = stage?.querySelector<HTMLElement>(
			"[data-banner-scroll-down]",
		);
		if (!isClassicHomeLayout()) {
			document.body.removeAttribute("data-banner-reveal");
			scrollDown?.classList.remove("banner-stage__scroll-down--hide");
			return;
		}
		const scrolled = window.scrollY > CLASSIC_SCROLL_REVEAL_THRESHOLD;
		document.body.toggleAttribute("data-banner-reveal", scrolled);
		scrollDown?.classList.toggle(
			"banner-stage__scroll-down--hide",
			scrolled,
		);
	}

	function requestClassicScrollState() {
		if (classicScrollTicking) return;
		classicScrollTicking = true;
		window.requestAnimationFrame(updateClassicScrollState);
	}

	// ---------------------------------------------------------------------
	// 壁纸模式 / 布局切换的柔和过渡（淡出 → 落位 → 淡入）由 setting-utils
	// 编排：几何由 html[data-wallpaper-mode] 直接驱动，落位必须发生在
	// data-wallpaper-switching 淡出完成之后，这里只响应变更事件做同步。
	// ---------------------------------------------------------------------
	if (stage) {
		syncBanner();
		updateHeroTitleParallax();
		updateClassicScrollState();
		if (!window.__shironeBannerBound) {
			window.__shironeBannerBound = true;
			window.addEventListener(WALLPAPER_MODE_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(WALLPAPER_FULLSCREEN_LAYOUT_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(BANNER_CAROUSEL_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(BANNER_TITLE_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(BANNER_WAVES_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(BANNER_GRADIENT_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(
				"scroll",
				() => {
					requestHeroTitleParallax();
					requestClassicScrollState();
				},
				{ passive: true },
			);
			window.addEventListener("resize", () => {
				requestHeroTitleParallax();
				requestClassicScrollState();
				if (currentViewport() === "desktop" && stage?.hidden === false) {
					scheduleContextTitleFit();
				}
			});
			window.addEventListener(WALLPAPER_MODE_CHANGE_EVENT, () => {
				requestHeroTitleParallax();
				requestClassicScrollState();
			});
			window.addEventListener(WALLPAPER_FULLSCREEN_LAYOUT_CHANGE_EVENT, () => {
				requestHeroTitleParallax();
				requestClassicScrollState();
			});
			// 下滑箭头点击：平滑滚动到内容区（事件委托，箭头随页面 SSR 常驻）。
			// 目标位置 = 内容区顶部 − 固定顶栏高度，避免内容首栏被顶栏遮住
			stage.addEventListener("click", (event) => {
				const target = event.target as Element | null;
				if (!target?.closest("[data-banner-scroll-down]")) return;
				const main = document.getElementById("main-layout");
				if (!main) return;
				const headerHeight =
					document.querySelector(".top-app-bar")?.getBoundingClientRect().height ??
					64;
				const top = main.getBoundingClientRect().top + window.scrollY - headerHeight;
				window.scrollTo({ top, behavior: "smooth" });
			});
			window.matchMedia("(min-width: 1024px)").addEventListener("change", () => syncBanner());
				window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", () => {
					if (prefersReducedMotion()) {
						stopLayerMotions();
						showSubtitleImmediately();
					}
					syncBanner();
				});
			document.addEventListener("visibilitychange", () => {
					if (document.hidden) {
						pauseLayerMotions();
					} else {
						resumeLayerMotions();
					}
					syncBanner();
				});
			document.addEventListener("swup:visit:start", () => {
				animateContextOut();
			});
			document.addEventListener("swup:content:replace", () => {
				scheduleNavigationSync(true);
			});
			document.addEventListener("swup:page:view", () => {
				scheduleNavigationSync(true);
				requestClassicScrollState();
			});
			document.fonts?.ready.then(scheduleContextTitleFit);
		}
	}
</script>

<style lang="stylus">
		.banner-stage
			position: absolute
			inset: 0 0 auto
			height: var(--banner-stage-height)
			overflow: hidden
			background: var(--surface-container-lowest)
			/* 模式切换时由 html[data-wallpaper-switching] 驱动的渐隐过渡 */
			transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)

			&[hidden]
				display: none

		/* 壁纸模式 / 布局切换：几何由 html[data-wallpaper-mode] 直接驱动，直接切换
		   会突兀跳变（忽大忽小）。setting-utils 先打 data-wallpaper-switching 让
		   舞台按旧形态淡出，220ms 后落位新几何并移除属性、淡入新形态。
		   切换期间统一 short 时长：覆盖透明自身的 long 过渡会晚于落位计时器，
		   导致几何在半透明状态被换掉；淡入由各模式自身的过渡接管 */
		:global(html[data-wallpaper-switching]) .banner-stage
			opacity: 0 !important
			transition-duration: var(--m3e-duration-short) !important

		.banner-stage__media,
		.banner-stage__scrim,
		.banner-stage__copy
			position: absolute
			inset: 0

		.banner-stage__image
			position: absolute
			inset: 0
			width: 100%
			height: 100%
			object-fit: cover
