		.banner-stage__image--fading
			transition: opacity var(--banner-fade-duration, 1200ms) var(--m3e-easing-standard)

		.banner-stage__image--active
			opacity: 1

		/* 横幅背景视频：默认透明（图片作海报层），播放时淡入覆盖 */
		.banner-stage__video
			position: absolute
			inset: 0
			width: 100%
			height: 100%
			object-fit: cover
			opacity: 0
