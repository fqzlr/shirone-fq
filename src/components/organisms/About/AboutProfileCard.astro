---
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

/**
 * 关于页 · 悬浮人物卡片（floating character card）。
 *
 * 用法（行内）：
 *   喵～ 本喵是<AboutProfileCard id="fqzlr" trigger="Fqzlr"
 *     name="Fqzlr" role="全干工程师" description="..." avatar={masterAvatar} />，
 *
 * 渲染为 <span tabindex="0"> 内嵌触发词 + 绝对定位的悬浮卡片；
 * hover / focus-within 触发淡入上移，卡片自带小三角指向触发词。
 *
 * 设计要点（M3E）：
 * - 触发词采用 primary 色虚线下划线，与正文 / 行内代码区分；
 * - 卡片使用 surface-container-high + outline-variant 描边；
 * - 头像为纯 <img>（组件常内嵌于 Markdown <p> 段落，
 *   不得使用块级元素，否则浏览器解析会拆散段落结构）；
 * - 入场 / 出场遵循 --m3e-duration-* + --m3e-easing-emphasized-decelerate；
 * - prefers-reduced-motion 关闭过渡。
 */

interface Props {
	/** 卡片唯一 id（同一页面多张人物卡片时必填以避免悬浮卡片 id 重复） */
	id: string;
	/** 触发词文本（默认 = name） */
	trigger?: string;
	/** 显示名（卡片标题） */
	name: string;
	/** 角色 / 身份（卡片副标题） */
	role: string;
	/** 角色描述（卡片正文） */
	description: string;
	/** 头像：本地资源（ImageMetadata）或 URL/相对路径字符串 */
	avatar?: ImageMetadata | string;
	/** 头像形状（默认 circle；方形头像可传 rounded） */
	avatarShape?: "circle" | "rounded" | "square";
	/** 触发词前可选小图标（Iconify 名） */
	icon?: string;
}

const {
	id,
	trigger,
	name,
	role,
	description,
	avatar,
	avatarShape = "circle",
	icon,
} = Astro.props;

const triggerText = trigger || name;
const avatarSrc = typeof avatar === "string" ? avatar : avatar?.src;
const cardId = `about-profile-card-${id}`;
---

<span class="about-profile-card" tabindex="0" aria-describedby={cardId}>
	<span class="about-profile-card__trigger">
		{icon && (
			<span class="about-profile-card__trigger-icon" aria-hidden="true">
				<Icon name={icon} />
			</span>
		)}
		{triggerText}
	</span>
	<span id={cardId} class="about-profile-card__card" role="tooltip">
		<span class="about-profile-card__avatar" aria-hidden="true">
			{avatarSrc ? (
				<img
					class={`about-profile-card__avatar-img about-profile-card__avatar-img--${avatarShape}`}
					src={avatarSrc}
					alt=""
					width="48"
					height="48"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<span class="about-profile-card__avatar-fallback">{name}</span>
			)}
		</span>
		<span class="about-profile-card__content">
			<span class="about-profile-card__name">{name}</span>
			<span class="about-profile-card__role">{role}</span>
			<span class="about-profile-card__description">{description}</span>
		</span>
	</span>
</span>

<style lang="stylus">
.about-profile-card
	position: relative
	display: inline-flex
	vertical-align: baseline
	max-width: 100%
	outline: none

	&__trigger
		display: inline-flex
		align-items: center
		gap: 0.25rem
		border-bottom: 1px dashed currentColor
		color: var(--primary)
		font-weight: 700
		cursor: help
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

	&__trigger-icon
		display: inline-flex
		color: inherit
		> :global(svg)
			width: 1rem
			height: 1rem

	&:hover &__trigger,
	&:focus-visible &__trigger
		color: var(--primary)
		border-bottom-color: var(--primary)

	&:focus-visible &__trigger
		border-radius: var(--shape-corner-xs)
		outline: 2px solid var(--primary)
		outline-offset: 0.1875rem

	&__card
		position: absolute
		top: calc(100% + 0.625rem)
		left: 0
		z-index: 20
		display: grid
		width: unquote("min(19rem, calc(100vw - 3rem))")
		grid-template-columns: 3rem minmax(0, 1fr)
		gap: 0.75rem
		padding: 0.75rem
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container-high)
		color: var(--on-surface)
		box-shadow: var(--m3e-elevation-2)
		font-size: 0.8125rem
		font-weight: 400
		line-height: 1.5
		transform: translateY(0.25rem)
		opacity: 0
		pointer-events: none
		transition:
			opacity var(--m3e-duration-short) var(--m3e-easing-emphasized-decelerate),
			transform var(--m3e-duration-short) var(--m3e-easing-emphasized-decelerate),
			visibility var(--m3e-duration-short) var(--m3e-easing-standard)
		visibility: hidden

	&__card::before
		position: absolute
		top: -0.4rem
		left: 1rem
		width: 0.75rem
		height: 0.75rem
		border-top: 1px solid var(--outline-variant)
		border-left: 1px solid var(--outline-variant)
		background: var(--surface-container-high)
		content: ""
		transform: rotate(45deg)

	&:hover &__card,
	&:focus-within &__card
		transform: none
		opacity: 1
		pointer-events: auto
		visibility: visible

	&__avatar
		display: flex
		align-items: center
		justify-content: center
		overflow: hidden

	&__avatar-img
		display: block
		width: 3rem
		height: 3rem
		object-fit: cover

		&--circle
			border-radius: var(--shape-corner-full)
		&--rounded
			border-radius: var(--shape-corner-m)
		&--square
			border-radius: 0

	&__avatar-fallback
		display: flex
		align-items: center
		justify-content: center
		width: 3rem
		height: 3rem
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-full)
		background: var(--surface-container-highest)
		color: var(--on-surface-variant)
		font-size: 0.6875rem
		font-weight: 700

	&__content
		display: flex
		min-width: 0
		flex-direction: column
		gap: 0.125rem

	&__name
		color: var(--primary)
		font-size: 0.875rem
		font-weight: 700
		line-height: 1.3

	&__role
		color: var(--on-surface-variant)
		font-size: 0.75rem
		font-weight: 500
		line-height: 1.4

	&__description
		margin-top: 0.25rem
		color: var(--on-surface)
		font-size: 0.8125rem
		font-weight: 400
		line-height: 1.55
		word-break: break-word

@media (max-width: 768px)
	.about-profile-card
		&__card
			width: unquote("min(17rem, calc(100vw - 2.5rem))")

@media (prefers-reduced-motion: reduce)
	.about-profile-card
		&__card
			transition: none
		&__trigger
			transition: none
</style>