---
/**
 * SponsorSection.astro
 * 打赏页内容有机体：页头（徽标 + 标题）、默认描述、用途提示条与打赏方式卡片网格。
 * 展示编排归本组件；数据来自 sponsorConfig（构建期配置，无客户端脚本、SSR 零水合）。
 * 卡片二态：qrcode → 扫码卡（图片白底保证扫码可读，内容性例外）；
 * url → 外链卡（“前往打赏”按钮）。两种都缺失的方式由 resolveSponsorMethods 过滤。
 */
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { resolveSponsorMethods, siteConfig, sponsorConfig } from "@/config";
import type { SponsorMethod } from "@/types/sponsorConfig";
import { resolveAsset } from "@/utils/asset-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
}

const className = Astro.props.class;

const methods = resolveSponsorMethods();

/** 打赏者名单：showSponsorsList !== false 时展示（空清单显示空态文案） */
const donors = sponsorConfig.sponsors ?? [];
const showDonors = sponsorConfig.showSponsorsList !== false;
const siteLang = siteConfig.lang.replace("_", "-");
const formatDonorDate = (date: string) => {
	try {
		return new Intl.DateTimeFormat(siteLang, { dateStyle: "medium" }).format(
			new Date(date),
		);
	} catch {
		return date;
	}
};

const fallbackDescription = i18n(I18nKey.sponsorDescription);
const description = (sponsorConfig.description ?? fallbackDescription).trim();

const fallbackUsage = i18n(I18nKey.sponsorUsage);
const usage = (sponsorConfig.usage ?? fallbackUsage).trim();

/** 收款码地址：public 路径经 url() 适配 base，本地相对路径走构建期资源解析 */
const resolveQrcodeSrc = async (method: SponsorMethod) => {
	const qrcode = method.qrcode ?? "";
	if (qrcode.startsWith("/")) return url(qrcode);
	if (/^(https?:|data:)/.test(qrcode)) return qrcode;
	return resolveAsset(qrcode);
};

const qrcodeSrcs = await Promise.all(
	methods.map((method) => resolveQrcodeSrc(method)),
);

/** 卡片默认描述：扫码卡“使用 {name} 扫码打赏”，外链卡“通过 {name} 打赏”（占位符各语言一致） */
const describeMethod = (method: SponsorMethod) => {
	const fallback = method.qrcode ? I18nKey.sponsorScan : I18nKey.sponsorLinkBy;
	return (method.description ?? i18n(fallback)).replace(
		/\{name\}/g,
		method.name,
	);
};

const qrAlt = (method: SponsorMethod) =>
	(method.qrcodeAlt ?? i18n(I18nKey.sponsorScan)).replace(
		/\{name\}/g,
		method.name,
	);

const isExternalUrl = (link: string) => /^https?:\/\//.test(link);
---

<section class:list={["sponsor", className]} aria-labelledby="sponsor-title">
	<div class="sponsor__card">
		<header class="sponsor__header">
			<span class="sponsor__badge" aria-hidden="true">
				<Icon name="material-symbols:favorite-rounded" />
			</span>
			<h2 id="sponsor-title">{i18n(I18nKey.sponsorBanner)}</h2>
		</header>
		{description && <p class="sponsor__description">{description}</p>}
		{
			usage && (
				<div class="sponsor__usage">
					<Icon
						name="material-symbols:info-rounded"
						aria-hidden="true"
					/>
					<p>{usage}</p>
				</div>
			)
		}
		{
			methods.length > 0 && (
				<ul class="sponsor__grid">
					{methods.map((method, index) => {
						const href = method.url ?? "";
						const external =
							method.external ?? isExternalUrl(href);
						const linkHref = href.startsWith("/")
							? url(href)
							: href;
						return (
							<li class="sponsor__method">
								<header class="sponsor__method-header">
									<Icon
										name={method.icon}
										aria-hidden="true"
									/>
									<h3>{method.name}</h3>
								</header>
								<p class="sponsor__method-description">
									{describeMethod(method)}
								</p>
								{method.qrcode && (
									<img
										class="sponsor__qrcode"
										src={qrcodeSrcs[index]}
										alt={qrAlt(method)}
										loading="lazy"
										decoding="async"
										width="240"
										height="240"
									/>
								)}
								{method.url && (
									<a
										class="sponsor__cta"
										href={linkHref}
										aria-label={`${i18n(I18nKey.sponsorVisit)} · ${method.name}`}
										{...(external
											? {
													target: "_blank",
													rel: "noreferrer noopener",
												}
											: {})}
									>
										{i18n(I18nKey.sponsorVisit)}
										<Icon
											name="material-symbols:open-in-new-rounded"
											aria-hidden="true"
										/>
									</a>
								)}
							</li>
						);
					})}
				</ul>
			)
		}
	</div>
	{
		showDonors && (
			<div class="sponsor__card sponsor__card--donors">
				<header class="sponsor__donors-header">
					<span class="sponsor__donors-badge" aria-hidden="true">
						<Icon name="material-symbols:emoji-people-rounded" />
					</span>
					<h2 id="sponsor-donors-title">{i18n(I18nKey.sponsorList)}</h2>
					{donors.length > 0 && (
						<span class="sponsor__donors-count">{donors.length}</span>
					)}
				</header>
				{donors.length > 0 ? (
					<ul class="sponsor__donors-grid">
						{donors.map((donor) => {
							const avatar = donor.avatar
								? donor.avatar.startsWith("/")
									? url(donor.avatar)
									: donor.avatar
								: "";
							return (
								<li class="sponsor__donor">
									{avatar ? (
										<img
											class="sponsor__donor-avatar"
											src={avatar}
											alt={donor.name}
											loading="lazy"
											decoding="async"
										/>
									) : (
										<span
											class="sponsor__donor-avatar sponsor__donor-avatar--initial"
											aria-hidden="true"
										>
											{donor.name.charAt(0)}
										</span>
									)}
									<div class="sponsor__donor-info">
										<div class="sponsor__donor-name-row">
											<span class="sponsor__donor-name">{donor.name}</span>
											{donor.amount && (
												<span class="sponsor__donor-amount">{donor.amount}</span>
											)}
										</div>
										{donor.date && (
											<time class="sponsor__donor-date" datetime={donor.date}>
												{formatDonorDate(donor.date)}
											</time>
										)}
									</div>
								</li>
							);
						})}
					</ul>
				) : (
					<p class="sponsor__donors-empty">{i18n(I18nKey.sponsorEmpty)}</p>
				)}
			</div>
		)
	}
</section>

<style lang="stylus">
.sponsor
	display: flex
	flex-direction: column
	gap: var(--m3e-space-4)

	&__card
		display: flex
		flex-direction: column
		gap: var(--m3e-space-4)
		padding: var(--m3e-space-6)
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-l)
		background: var(--card-bg)

	&__header
		display: flex
		align-items: center
		gap: var(--m3e-space-3)

		h2
			margin: 0
			font: var(--m3e-type-headline-small)
			font-weight: 700
			color: var(--on-surface)

	&__badge
		display: inline-flex
		align-items: center
		justify-content: center
		width: 2.5rem
		height: 2.5rem
		flex-shrink: 0
		border-radius: var(--shape-corner-m)
		background: var(--primary)
		color: var(--on-primary)

		> :global(svg)
			width: 1.375rem
			height: 1.375rem

	&__description
		margin: 0
		font: var(--m3e-type-body-medium)
		line-height: 1.7
		color: var(--on-surface-variant)

	&__usage
		display: flex
		align-items: flex-start
		gap: var(--m3e-space-2)
		padding: var(--m3e-space-3) var(--m3e-space-4)
		border-radius: var(--shape-corner-m)
		background: var(--primary-container)
		color: var(--on-primary-container)

		> :global(svg)
			width: 1.125rem
			height: 1.125rem
			flex-shrink: 0
			margin-top: 0.2em

		p
			margin: 0
			font: var(--m3e-type-body-medium)
			line-height: 1.6

	&__grid
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-4)
		margin: var(--m3e-space-2) 0 0
		padding: 0
		list-style: none

		@media (max-width: 40rem)
			grid-template-columns: 1fr

	&__method
		display: flex
		flex-direction: column
		align-items: center
		gap: var(--m3e-space-3)
		padding: var(--m3e-space-6) var(--m3e-space-4)
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container)
		text-align: center

	&__method-header
		display: flex
		align-items: center
		gap: var(--m3e-space-2)
		color: var(--on-surface)

		> :global(svg)
			width: 1.375rem
			height: 1.375rem
			color: var(--primary)

		h3
			margin: 0
			font: var(--m3e-type-title-medium)
			font-weight: 700

	&__method-description
		margin: 0
		font: var(--m3e-type-body-medium)
		color: var(--on-surface-variant)

	/* 收款码白底内边距：二维码识别需要留白与浅底，属内容性固定色例外 */
	&__qrcode
		width: min(100%, 15rem)
		height: auto
		padding: 0.75rem
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-m)
		background: #fff

	&__cta
		display: inline-flex
		align-items: center
		gap: 0.375rem
		padding: 0.5rem 1.25rem
		border-radius: var(--shape-corner-m)
		background: var(--primary)
		color: var(--on-primary)
		font: var(--m3e-type-label-large)
		font-weight: 600
		text-decoration: none
		transition:
			filter var(--m3e-duration-short) var(--m3e-easing-standard),
			transform var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover
			filter: brightness(1.08)

		&:active
			transform: scale(0.97)

		&:focus-visible
			outline: 2px solid var(--primary)
			outline-offset: 2px

		> :global(svg)
			width: 1rem
			height: 1rem

	/* 打赏者名单卡片 */
	&__donors-header
		display: flex
		align-items: center
		gap: var(--m3e-space-3)

		h2
			margin: 0
			font: var(--m3e-type-title-large)
			font-weight: 700
			color: var(--on-surface)

	&__donors-badge
		display: inline-flex
		align-items: center
		justify-content: center
		width: 2rem
		height: 2rem
		flex-shrink: 0
		border-radius: var(--shape-corner-m)
		background: var(--primary-container)
		color: var(--on-primary-container)

		> :global(svg)
			width: 1.125rem
			height: 1.125rem

	&__donors-count
		margin-left: auto
		padding: 0.125rem 0.625rem
		border-radius: var(--shape-corner-full)
		background: var(--surface-container)
		font: var(--m3e-type-label-medium)
		font-variant-numeric: tabular-nums
		color: var(--on-surface-variant)

	&__donors-grid
		display: grid
		grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr))
		gap: var(--m3e-space-3)
		margin: 0
		padding: 0
		list-style: none

	&__donor
		display: flex
		align-items: center
		gap: var(--m3e-space-3)
		min-width: 0
		padding: 0.625rem 0.75rem
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-m)
		transition: border-color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover
			border-color: var(--primary)

	&__donor-avatar
		width: 2.25rem
		height: 2.25rem
		flex-shrink: 0
		border-radius: var(--shape-corner-full)
		object-fit: cover

		&--initial
			display: inline-flex
			align-items: center
			justify-content: center
			background: var(--primary-container)
			font: var(--m3e-type-title-small)
			font-weight: 700
			color: var(--on-primary-container)

	&__donor-info
		display: flex
		flex-direction: column
		gap: 0.125rem
		flex: 1
		min-width: 0

	&__donor-name-row
		display: flex
		align-items: center
		gap: var(--m3e-space-2)
		min-width: 0

	&__donor-name
		overflow: hidden
		font: var(--m3e-type-label-large)
		font-weight: 600
		color: var(--on-surface)
		text-overflow: ellipsis
		white-space: nowrap

	&__donor-amount
		flex-shrink: 0
		font: var(--m3e-type-label-medium)
		font-weight: 700
		font-variant-numeric: tabular-nums
		color: var(--primary)

	&__donor-date
		font: var(--m3e-type-label-small)
		font-variant-numeric: tabular-nums
		color: var(--on-surface-variant)

	&__donors-empty
		margin: 0
		padding: var(--m3e-space-6) 0
		font: var(--m3e-type-body-medium)
		color: var(--on-surface-variant)
		text-align: center
</style>
