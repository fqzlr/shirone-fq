---
import { createRequire } from "node:module";
/**
 * 站点信息侧栏 widget（规格表 + 可展开构建信息卡片网格）。
 * 主行 = 构建平台 / 博客版本 / 文章许可；`<details>` 原生折叠展开构建信息
 * 网格（域名 / Astro / Node / pnpm / 构建时间 / 系统信息），全部构建期取值、
 * 零客户端脚本。数据来源：环境变量识别（utils/build-platform）、
 * package.json 版本、licenseConfig。
 */
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { detectBuildPlatform } from "@utils/build-platform";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig, siteConfig } from "@/config";
import type { SiteInfoWidget } from "@/types/sidebarConfig";
import pkg from "../../../package.json";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	widget?: SiteInfoWidget;
}

const className = Astro.props.class;
const style = Astro.props.style;

// Astro 版本：构建期从依赖清单读取；导出不可达时静默省略该行
let astroVersion = "";
try {
	const require = createRequire(import.meta.url);
	astroVersion =
		(require("astro/package.json") as { version?: string }).version ?? "";
} catch {
	astroVersion = "";
}

// pnpm 版本：从 npm_config_user_agent 解析（构建工具链信息）；解析失败时省略该行
const pnpmVersion = (() => {
	const match = /pnpm\/([\d.]+)/.exec(process.env.npm_config_user_agent ?? "");
	return match ? `v${match[1]}` : "";
})();

// 系统信息：构建机平台 + 架构（与参考实现同语义，展示构建环境）
const platformNames: Record<string, string> = {
	win32: "Windows",
	darwin: "macOS",
	linux: "Linux",
	freebsd: "FreeBSD",
};
const archNames: Record<string, string> = {
	x64: "x86_64",
	arm64: "ARM64",
	arm: "ARM",
	ia32: "x86",
};
const systemInfo = `${platformNames[process.platform] ?? process.platform} / ${archNames[process.arch] ?? process.arch}`;

const domain = (() => {
	try {
		return new URL(siteConfig.site).hostname;
	} catch {
		return "";
	}
})();

// 构建时间：站点时区 + 站点语言格式化到秒（时区非法时回退 ISO 日期）
const builtAt = (() => {
	try {
		return new Intl.DateTimeFormat(siteConfig.lang.replace("_", "-"), {
			year: "numeric",
			month: "long",
			day: "numeric",
			hour: "2-digit",
			minute: "2-digit",
			second: "2-digit",
			hour12: false,
			timeZone: siteConfig.timeZone,
		}).format(new Date());
	} catch {
		return new Date().toISOString().slice(0, 10);
	}
})();

const mainRows = [
	{
		icon: "material-symbols:cloud-outline-rounded",
		label: i18n(I18nKey.siteInfoPlatform),
		value: detectBuildPlatform(),
	},
	{
		icon: "material-symbols:rocket-launch-outline-rounded",
		label: i18n(I18nKey.siteInfoVersion),
		value: `v${pkg.version}`,
	},
	...(licenseConfig.enable
		? [
				{
					icon: "material-symbols:copyright-outline-rounded",
					label: i18n(I18nKey.siteInfoLicense),
					value: licenseConfig.name,
					href: licenseConfig.url,
				},
			]
		: []),
];

interface DetailRow {
	icon: string;
	label: string;
	value: string;
	/** 独占整行（域名 / 构建时间 / 系统信息这类长值） */
	full?: boolean;
}

const detailRows: DetailRow[] = [
	...(domain
		? [
				{
					icon: "material-symbols:language-rounded",
					label: i18n(I18nKey.siteInfoDomain),
					value: domain,
					full: true,
				},
			]
		: []),
	{
		icon: "material-symbols:rocket-launch-outline-rounded",
		label: i18n(I18nKey.siteInfoVersion),
		value: `v${pkg.version}`,
	},
	...(astroVersion
		? [
				{
					icon: "material-symbols:auto-awesome-outline-rounded",
					label: i18n(I18nKey.siteInfoAstro),
					value: `v${astroVersion}`,
				},
			]
		: []),
	{
		icon: "material-symbols:terminal-rounded",
		label: i18n(I18nKey.siteInfoNode),
		value: process.version,
	},
	...(pnpmVersion
		? [
				{
					icon: "simple-icons:pnpm",
					label: i18n(I18nKey.siteInfoPnpm),
					value: pnpmVersion,
				},
			]
		: []),
	{
		icon: "material-symbols:schedule-rounded",
		label: i18n(I18nKey.siteInfoBuiltAt),
		value: builtAt,
		full: true,
	},
	{
		icon: "material-symbols:computer-outline-rounded",
		label: i18n(I18nKey.siteInfoSystem),
		value: systemInfo,
		full: true,
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteInfo)} id="site-info" class={className} style={style}>
	<ul class="site-info">
		{mainRows.map((row) => (
			<li class="site-info__row">
				<MetaIcon icon={row.icon} />
				<span class="site-info__label">{row.label}</span>
				<span class="site-info__rule" aria-hidden="true"></span>
				{"href" in row && row.href
					? (
						<a class="site-info__value site-info__value--link" href={url(row.href)} rel="noreferrer noopener" target="_blank">
							{row.value}
						</a>
					)
					: <span class="site-info__value">{row.value}</span>}
			</li>
		))}
	</ul>
	<details class="site-info__more">
		<summary class="site-info__summary">
			<span class="site-info__summary-text site-info__summary-text--open-label">{i18n(I18nKey.siteInfoMore)}</span>
			<span class="site-info__summary-text site-info__summary-text--close-label">{i18n(I18nKey.siteInfoLess)}</span>
			<Icon name="material-symbols:keyboard-arrow-down-rounded" class="site-info__chevron" aria-hidden="true" />
		</summary>
		<div class="site-info__grid">
			{detailRows.map((row) => (
				<div class:list={["site-info__card", { "site-info__card--full": row.full }]} title={row.value}>
					<Icon name={row.icon} class="site-info__card-icon" aria-hidden="true" />
					<span class="site-info__card-label">{row.label}</span>
					<span class="site-info__card-value">{row.value}</span>
				</div>
			))}
		</div>
	</details>
</WidgetLayout>

<style lang="stylus">
.site-info
	display: flex
	flex-direction: column
	gap: var(--m3e-space-2)
	margin: 0
	padding: 0
	list-style: none

	&__row
		display: flex
		align-items: center
		gap: 0.625rem

	&__label
		font: var(--m3e-type-body-medium)
		font-weight: 500
		color: var(--on-surface-variant)
		white-space: nowrap

	/* 点线引导：与 SiteStats 同语言 */
	&__rule
		flex: 1
		align-self: flex-end
		margin-bottom: 0.35em
		min-width: 0.75rem
		border-bottom: 2px dotted var(--outline-variant)

	&__value
		font: var(--m3e-type-title-small)
		font-weight: 600
		font-variant-numeric: tabular-nums
		color: var(--on-surface)
		white-space: nowrap

		&--link
			color: var(--primary)

			&:hover
				text-decoration: underline

	/* 可展开的构建信息：2 列卡片网格，full 项独占整行 */
	&__grid
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-2)
		padding-top: var(--m3e-space-2)

	&__card
		display: flex
		flex-direction: column
		align-items: center
		gap: 0.125rem
		min-width: 0
		padding: 0.5rem 0.375rem
		border-radius: var(--shape-corner-m)
		background: var(--surface-container)
		text-align: center

		&--full
			grid-column: 1 / -1

	&__card-icon
		width: 1.25rem
		height: 1.25rem
		color: var(--primary)

	&__card-label
		font: var(--m3e-type-label-medium)
		color: var(--on-surface-variant)

	&__card-value
		max-width: 100%
		overflow: hidden
		font: var(--m3e-type-title-small)
		font-weight: 700
		font-variant-numeric: tabular-nums
		color: var(--on-surface)
		text-overflow: ellipsis
		white-space: nowrap

	&__more
		display: flex
		flex-direction: column
		margin-top: var(--m3e-space-2)

		/* 折叠按钮沉底（与参考布局一致）：展开时网格在上、按钮在下 */
		& &__summary
			order: 2

		& &__grid
			order: 1

	&__summary
		display: flex
		align-items: center
		justify-content: center
		gap: 0.25rem
		padding: 0.375rem 0.75rem
		border-radius: var(--shape-corner-full)
		font: var(--m3e-type-label-large)
		color: var(--primary)
		cursor: pointer
		user-select: none
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover
			background: var(--btn-plain-bg-hover)

		&::-webkit-details-marker
			display: none

	&__summary-text
		&--close-label
			display: none

		&--open-label
			display: inline

	&__more[open] &__summary-text
		&--open-label
			display: none

		&--close-label
			display: inline

	&__chevron
		width: 1.125rem
		height: 1.125rem
		transition: transform var(--m3e-duration-medium) var(--m3e-easing-standard)

	&__more[open] &__chevron
		transform: rotate(180deg)
</style>
